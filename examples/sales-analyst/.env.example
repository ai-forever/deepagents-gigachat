# ─────────────────────────────────────────────────────────────────────
# GigaChat — конфигурация для блокнота deepagents-gigachat-practice.
# Скопируйте этот файл в .env и заполните значения.
#   cp .env.example .env
# Настоящий .env НЕ коммитить (добавьте его в .gitignore).
# ─────────────────────────────────────────────────────────────────────

# ── Авторизация ──────────────────────────────────────────────────────
# Вариант A (проще): авторизационный ключ — один base64-токен.
# Взять на developers.sber.ru → ваш проект → раздел с ключами.
GIGACHAT_CREDENTIALS=

# Вариант B (вместо ключа): пара client id / client secret.
# Раскомментируйте, если у вас нет единого ключа, и оставьте GIGACHAT_CREDENTIALS пустым.
# GIGACHAT_USER=
# GIGACHAT_PASSWORD=

# Scope доступа: физлицам — GIGACHAT_API_PERS, компаниям — GIGACHAT_API_B2B или GIGACHAT_API_CORP.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# ── Модель и эндпоинт ────────────────────────────────────────────────
# Модель, на которой пробуем. Меняйте под доступные вам, например:
# GigaChat-3-Ultra, GigaChat-2-Max, GigaChat-Max, GigaChat-Pro, GigaChat
GIGACHAT_MODEL=GigaChat-3-Ultra

# Базовый URL API. Обычно менять не нужно.
GIGACHAT_BASE_URL=https://gigachat.sberdevices.ru/v1

# ── Соединение ───────────────────────────────────────────────────────
# Отключить проверку SSL-сертификатов НУЦ Минцифры (True/False).
GIGACHAT_VERIFY_SSL_CERTS=False

# Отключить фильтр нецензурной лексики (True/False).
GIGACHAT_PROFANITY_CHECK=False

# Таймаут запроса в секундах. Агентные шаги бывают долгими — держим с запасом.
GIGACHAT_TIMEOUT=600

# ── Генерация ────────────────────────────────────────────────────────
# top_p=0 — максимально детерминированно (как в примерах статьи).
# Поднимите для большего разнообразия ответов.
GIGACHAT_TOP_P=0
